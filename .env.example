# ============================================================
# AEGIS — Template de configuration
# Copiez ce fichier vers .env et renseignez vos vraies valeurs.
# NE JAMAIS mettre de vrais secrets dans ce fichier.
# ============================================================

# ===== EXCHANGE =====
EXCHANGE=kraken
TESTNET=False

# ===== CLÉS API KRAKEN =====
KRAKEN_API_KEY=votre_cle_kraken_ici
KRAKEN_API_SECRET=votre_secret_kraken_ici

# ===== TELEGRAM =====
BOT_NAME=Aegis
TELEGRAM_BOT_TOKEN=votre_token_telegram
TELEGRAM_CHAT_ID=votre_chat_id
TELEGRAM_DAILY_STATUS_ENABLED=True
TELEGRAM_DAILY_STATUS_HOUR=8

# ===== TRADING CORE =====
TRADING_PAIRS=BTCUSD,ETHUSD,SOLUSD,ADAUSD
MAIN_TIMEFRAME=15m
AUTO_START_BOT=True
PAPER_TRADING=True
TRADE_AMOUNT=5

# ===== GESTION SOLDE =====
USE_FULL_BALANCE=False
MAX_BALANCE_PER_TRADE=50
RISK_PER_TRADE=2

# ===== GESTION RISQUES =====
MAX_DAILY_TRADES=50
MAX_DAILY_LOSS=50
MAX_WEEKLY_LOSS=150
MAX_DAILY_LOSING_TRADES=10
EMERGENCY_STOP_LOSS=200
STOP_LOSS_PERCENT=5
TRAILING_STOP_PERCENT=2.5
MAX_TOTAL_CAPITAL_EXPOSURE_PCT=60
MAX_POSITIONS_PER_CRYPTO=2
MAX_TOTAL_POSITIONS=8
MAX_POSITION_TRADE_AMOUNT_MULTIPLIER=2
SELL_LIMIT_ARM_DISTANCE_PCT=0.30
SYMBOL_COOLDOWN_SECONDS=300
SYMBOL_FAILURE_COOLDOWN_SECONDS=120

# ===== BREAKEVEN STOP =====
BREAKEVEN_STOP_ENABLED=True
BREAKEVEN_USE_RESISTANCE=True
BREAKEVEN_TRIGGER_PROFIT_PCT=1.5
BREAKEVEN_LOCK_PROFIT_PCT=1
BREAKEVEN_MIN_NET_PROFIT_PCT=0.02
BREAKEVEN_TRIGGER_BUFFER_PCT=0
BREAKEVEN_MIN_STOP_GAP_PCT=0.01

# ===== BEAR MODE =====
MARKET_REGIME_FILTER=True
BEAR_MODE_TRADE_MULTIPLIER=0.35
BEAR_MODE_MIN_CONFIDENCE_BONUS=20
MARKET_CONTEXT_CACHE_SECONDS=300

# ===== SCORING CRYPTOS =====
MIN_CRYPTO_SCORE=40

# ===== FRAIS =====
# Fallback local. En live, Aegis tente d'abord de récupérer les frais réels Kraken.
TRADING_FEE_PERCENT=0.4
FEE_SYNC_INTERVAL_SECONDS=3600
MIN_PROFIT_THRESHOLD=0.8

# ===== PAPER TRADING =====
PAPER_BALANCE=1000

# ===== POSITIONS BLOQUÉES =====
MAX_STUCK_LOSS=15
STUCK_THRESHOLD_HOURS=24

# ===== FALLBACK SÉCURISÉ =====
SAFE_FALLBACK_ENABLED=True
SAFE_FALLBACK_CHECK_INTERVAL_SECONDS=300
SAFE_FALLBACK_CONSECUTIVE_LOSSES=3
SAFE_FALLBACK_DAILY_LOSS_USD=50
SAFE_FALLBACK_WEEKLY_LOSS_USD=150
SAFE_FALLBACK_DRIFT_STATUSES=warning,critical

# ===== HEALTH CHECKS =====
HEALTH_CHECK_INTERVAL_SECONDS=300
HEALTH_NOTIFY_INTERVAL_SECONDS=1800
HEALTH_SAFE_FALLBACK_ENABLED=False
HEALTH_CRITICAL_FALLBACK_AFTER=3

# ===== CORE ML — ENTRÉE =====
ML_MIN_PROBABILITY=50.0
HARD_ANTI_FALLING_KNIFE=True
AEGIS_MODEL_VERSION=4
ML_STRICT_MODEL_SCHEMA=True
ALLOW_UNTRAINED_ML_ENTRIES=False
ML_ALLOW_SCHEMA_BOOTSTRAP_PROMOTION=True
ML_SCHEMA_BOOTSTRAP_MIN_TRAIN_SAMPLES=200
ML_MIN_EXPECTED_NET_PNL_PCT=0.05
ML_EXPECTED_SLIPPAGE_PCT=0.03
PAPER_MARKET_SLIPPAGE_PCT=0.03
PAPER_SPREAD_SLIPPAGE_FACTOR=0.25
PAPER_MARKET_LATENCY_MS=150
PAPER_LIMIT_LATENCY_MS=500
PAPER_SIMULATE_LATENCY_SLEEP=False
PAPER_SIMULATE_PARTIAL_FILLS=True
PAPER_LIMIT_PARTIAL_FILL_RATIO=0.50
PAPER_USE_LIVE_FILL_CALIBRATION=True
PAPER_FILL_CALIBRATION_MIN_ORDERS=10
PAPER_FILL_CALIBRATION_LOOKBACK=100
PAPER_LIMIT_FULL_FILL_PENETRATION_PCT=0.05
ML_EXIT_ENTRY_MIN_CONTINUE_PROB=50.0
ML_EXIT_HIGH_PWIN_THRESHOLD=65.0
ML_EXIT_MIN_CONTINUE_HIGH_PWIN=45.0
ML_EXIT_SELL_THRESHOLD=35.0
ML_EXIT_PROFIT_PROTECT_MIN_NET_PCT=0.35
ML_EXIT_PROFIT_PROTECT_THRESHOLD=70.0
ML_OWNS_EXITS=True
HYBRID_PHYSICAL_SAFETY=True

# ===== EXIT DECISION ENGINE =====
EXIT_ENGINE_ENABLED=True
PROFIT_FRAGILE_MAX_NET_PCT=0.40
TIME_STOP_MINUTES=12

# ===== P_EXIT : DURÉE DYNAMIQUE =====
ML_EXIT_TREND_EXIT=true
ML_EXIT_TREND_CONFIRM_BARS=2
ML_EXIT_MAX_HOLD_CANDLES=960
ML_EXIT_CLASS_WEIGHT=balanced_subsample
ML_EXIT_MIN_HOLD_EDGE_PCT=0.05
ML_EXIT_HOLD_TIME_COST_PCT_PER_DAY=0.02
ML_EXIT_MAX_TRAIN_SAMPLES=16000

# ===== P_TARGET (take-profit intelligent) =====
ML_TAKE_PROFIT_ENABLED=true
ML_TARGET_MIN_PCT=0.8
ML_TARGET_MAX_PCT=12.0
ML_TARGET_PATH_QUANTILE=0.70

# ===== MOTEUR ML =====
ML_USE_LIGHTGBM=True
ML_USE_GRID_SEARCH=True
ML_TEMPORAL_TEST_RATIO=0.20
ML_CV_SPLITS=3

# Grid Search persistant : checkpoint après chaque combinaison, reprise après crash
# et réutilisation des meilleurs paramètres entre deux recherches complètes.
ML_GRID_CACHE_ENABLED=True
ML_GRID_CACHE_DIR=data/ml_search
ML_GRID_RESUME=True
ML_GRID_REUSE_BEST=True
ML_GRID_FULL_SEARCH_INTERVAL_DAYS=30
ML_GRID_RESEARCH_ON_DRIFT=True
ML_GRID_RESEARCH_DRIFT_STATUSES=warning,critical
ML_GRID_RESEARCH_MIN_LIVE_WIN_RATE=55
ML_GRID_RESEARCH_MAX_CALIBRATION_MAE=20
ML_GRID_FORCE_SEARCH=False

# ===== AUTO-RETRAINING ML =====
ML_AUTO_RETRAIN_ENABLED=False
ML_AUTO_RETRAIN_INTERVAL_SECONDS=604800
ML_AUTO_RETRAIN_CHECK_ONLY=True
ML_AUTO_RETRAIN_FAST=False
ML_TRAINING_HISTORY_DAYS=1095
ML_TRAINING_MAX_CANDLES=330000
ML_OHLCV_CACHE_ENABLED=true
ML_OHLCV_CACHE_DIR=data/ohlcv_cache
ML_KRAKEN_ARCHIVE_DIR=data/kraken_ohlcv
ML_ARCHIVE_KRAKEN_BEFORE_TRAIN=True
ML_PREFER_KRAKEN_ARCHIVE=True
ML_KRAKEN_ARCHIVE_REQUIRE_ALL_TIMEFRAMES=True
ML_KRAKEN_ARCHIVE_REQUIRED_TIMEFRAMES=5m,15m,1h,4h,1d
ML_KRAKEN_ARCHIVE_MIN_COVERAGE_RATIO=0.95
ML_KRAKEN_ARCHIVE_MAX_STALENESS_CANDLES=3
ML_FETCH_CONCURRENCY=5
ML_FETCH_PROGRESS=true

# ===== PROMOTION CHALLENGER =====
ML_PROMOTION_MIN_CLOSED_TRADES=30
ML_PROMOTION_MIN_ACTIVE_DAYS=3
ML_PROMOTION_MAX_DRAWDOWN_PCT=8.0
ML_PROMOTION_MIN_PROFIT_FACTOR=1.10
ML_PROMOTION_MIN_PRECISION_DELTA=-0.5
ML_PROMOTION_MIN_ACCURACY_DELTA=-1.0
ML_PROMOTION_MAX_CALIBRATION_MAE=20.0
ML_PROMOTION_REQUIRE_CALIBRATION=False
ML_PROMOTION_MAX_OOS_BASELINE_RATIO=1.05
ML_PROMOTION_ALLOWED_DRIFT_STATUSES=ok,insufficient_live_outcomes
ML_SHADOW_CHALLENGER_ENABLED=True
ML_PROMOTION_REQUIRE_SHADOW=True
ML_PROMOTION_SHADOW_MIN_OUTCOMES=30
ML_PROMOTION_SHADOW_MIN_PNL_DELTA_PCT=0.0
ML_PROMOTION_SHADOW_MAX_DD_DELTA_PCT=0.5

# ===== ANALYSE LIVE ML =====
ML_LIVE_ANALYSIS_INTERVAL_SECONDS=21600
ML_LIVE_ANALYSIS_MAX_REPLAY=250
ML_REPLAY_REQUEST_PAUSE_SECONDS=1.2
ML_REPLAY_REQUEST_RETRIES=3
ML_REPLAY_RETRY_BACKOFF=2.0


# ===== BACKTEST / SUPPORT TOUCH =====
BACKTEST_TIMEFRAME=15m
BACKTEST_LIMIT=720
BACKTEST_LOOKBACK=50
BACKTEST_MAX_HOLD_CANDLES=96
BACKTEST_TARGET_PERCENT=1.5
BACKTEST_STOP_PERCENT=1.0
BACKTEST_COOLDOWN_CANDLES=4
SUPPORT_TOUCH_ADAPTIVE_FILTER=True
SUPPORT_TOUCH_BACKTEST_SOURCE=data/aegis_db.sqlite3
SUPPORT_TOUCH_BACKTEST_TIMEOUT_SECONDS=90

# ===== DATABASE / RUNTIME =====
ML_LIVE_SQLITE_FILE=data/aegis_db.sqlite3
AEGIS_DB_PATH=data/aegis_db.sqlite3
ACCOUNTING_TRANSACTION_SOURCE=True
KRAKEN_LEDGER_SYNC_ENABLED=True
KRAKEN_LEDGER_SYNC_INTERVAL_SECONDS=300

# ===== EXÉCUTION =====
MAX_EXECUTION_SPREAD_PCT=0.08
SPREAD_PAUSE_TIMEOUT_SEC=1.0
LIMIT_FILL_TIMEOUT_SEC=2.0
LIMIT_FILL_POLL_SEC=0.25
ADAPTIVE_MAKER_ORDERS=True
KLINE_REST_CACHE_TTL_SECONDS=10

# ===== INDICATEURS / DEBUG =====
MIN_CONFIDENCE=30
MIN_VOLUME_RATIO=1.2
ADX_TRENDING_THRESHOLD=25
BTC_CORRELATION_FILTER=False
AGGRESSIVE_MODE=False
WS_CONNECTION_DEBUG=False
WS_PRELOAD_DEBUG=False

# ===== MONITORING =====
LOG_LEVEL=INFO
SAVE_LOGS=True
DECISION_JOURNAL_MAX=5000

# ===== UI =====
DASHBOARD_PORT=8080
LIVE_STATUS_INTERVAL_SECONDS=1

# ===== WALK-FORWARD COMPLET =====
FULL_STRATEGY_WALK_FORWARD=True
FULL_STRATEGY_REFERENCE_NOTIONAL_USD=100.0
FULL_STRATEGY_ROUNDTRIP_SLIPPAGE_PCT=0.06
FULL_STRATEGY_FALLBACK_SPREAD_PCT=0.04
FULL_STRATEGY_EXIT_MAX_SAMPLES=6000
